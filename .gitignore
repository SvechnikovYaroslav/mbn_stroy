# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*
!.env.example
!.env.production.example

# vercel
.vercel

# local temp
.tmp-shots/
.cache/

# Local SSH deploy wrapper / machine-specific connection
deploy.local.env
.deploy.lock

# Payload local uploads (not public/media demo assets)
/media/

# Database dumps created by backup scripts
/backups/
*.sql.gz

# Original HEIC uploads (not web-safe; convert before publishing)
/media-source/

# typescript
*.tsbuildinfo
next-env.d.ts
