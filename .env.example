# Local PostgreSQL (Docker Compose defaults)
# DATABASE_URL=postgresql://mbn_stroy:mbn_stroy_local_dev@127.0.0.1:5432/mbn_stroy
#
# Or an existing local PostgreSQL database/user, for example:
# DATABASE_URL=postgresql://mbn_stroy_dev:PASSWORD@127.0.0.1:5432/mbn_stroy
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mbn_stroy

# Long random string used to sign Payload auth tokens (min ~32 chars)
PAYLOAD_SECRET=

# Public site origin for canonical / OG / sitemap / robots (no trailing slash)
# Example: https://otdelka360.ru
NEXT_PUBLIC_SITE_URL=

# development | staging | production
# staging → noindex + robots Disallow: /
SITE_ENV=development

# Optional: Yandex Object Storage. If unset, Payload uses local /media uploads.
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
