NODE_ENV=production

SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=

PAYLOAD_SECRET=

POSTGRES_DB=otdelka_360
POSTGRES_USER=otdelka_360_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://otdelka_360_app:PASSWORD@postgres:5432/otdelka_360

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=otdelka-360-media
BACKUP_S3_BUCKET=otdelka-360-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STAGE_DOMAIN=

# Optional: Yandex Metrika counter (loaded only after analytics consent)
# YANDEX_METRIKA_ID=

# Optional: lead email notifications via Yandex SMTP.
# Without these, leads still save to DB — notifications are just skipped.
# SMTP_PASS = Yandex app password (not the account password).
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=otdelka-360@yandex.ru
# SMTP_PASS=
# SMTP_FROM=otdelka-360@yandex.ru
# NOTIFY_EMAIL=otdelka-360@yandex.ru
